# Copy this file to .env.local and fill in your Supabase credentials.
# Find these in: Supabase Dashboard → Settings → API

# Your Supabase project URL (e.g. https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public key (safe to expose — RLS enforces access control)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
